<UserControl x:Class="FF14HouseReminder.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="382" Background="#D8D8CF"
             FontFamily="Tahoma, Microsoft YaHei UI" FontSize="12">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3,0,8"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="BorderBrush" Value="#ABABA0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="H">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#55554A"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background" Value="#F2F2EB"/>
            <Setter Property="Foreground" Value="#3F3F38"/>
            <Setter Property="BorderBrush" Value="#ABABA0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="4,3"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#ABABA0" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

                <TextBlock Text="⊙  设置" FontWeight="Bold" FontSize="15" Foreground="#55554A"/>

            <TextBlock Text="── 提醒规则" Style="{StaticResource H}"/>
            <TextBlock Text="截止前提醒（可多选，最多 3 个）" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,2,0,6" x:Name="LeadChips">
                <CheckBox Content="72h" Tag="72" Margin="0,0,8,0"/>
                <CheckBox Content="48h" Tag="48" Margin="0,0,8,0"/>
                <CheckBox Content="24h" Tag="24" Margin="0,0,8,0"/>
                <CheckBox Content="12h" Tag="12" Margin="0,0,8,0"/>
                <CheckBox Content="6h" Tag="6" Margin="0,0,8,0"/>
                <CheckBox Content="3h" Tag="3" Margin="0,0,8,0"/>
                <CheckBox Content="1h" Tag="1" Margin="0,0,8,0"/>
            </WrapPanel>
                <CheckBox Content="申请期截止前提醒（快去报名）" IsChecked="{Binding NotifyEntryDeadline}"/>
                <CheckBox Content="开奖提醒（进入公示期，仅已报名）" IsChecked="{Binding NotifyResultsStart}"/>
                <CheckBox Content="公示期截止前提醒（中签确认归属死线）" IsChecked="{Binding NotifyClaimDeadline}"/>
                <CheckBox Content="抽签金返还死线提醒（公示期后 90 天）" IsChecked="{Binding NotifyDepositDeadline}"/>
                <CheckBox Content="下轮申请期开始提醒" IsChecked="{Binding NotifyNextEntryStart}"/>

                <TextBlock Text="── 常规" Style="{StaticResource H}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="数据轮询间隔（分钟，≥5）：" VerticalAlignment="Center"/>
                    <TextBox Width="50" Text="{Binding PollIntervalMinutes}" Margin="4,2"/>
                </StackPanel>
                <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStart}" Click="AutoStart_Click"/>
                <CheckBox Content="启动时检查新版本" IsChecked="{Binding CheckUpdates}"/>

                <TextBlock Text="── 网页 / Bot 账号" Style="{StaticResource H}"/>
                <TextBlock Foreground="#8A8A80" FontSize="11" TextWrapping="Wrap"
                           Text="链接后三端共用一份关注和房产，以云端为准。程序没开时照旧靠任务计划弹提醒。"/>
                <TextBlock Text="绑定链接（或 u=..&amp;k=..）：" Margin="0,6,0,0"
                           ToolTip="Telegram 里给 Bot 发 /link 拿到；网页版右上角齿轮里也有"/>
                <TextBox Text="{Binding CloudLink}" ToolTip="粘贴 Bot 给的链接即可，会自动解析出账号和令牌"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="链接并同步" Style="{StaticResource Btn}" Click="LinkCloud_Click"/>
                    <Button Content="解除链接" Style="{StaticResource Btn}" Click="UnlinkCloud_Click"/>
                </StackPanel>
                <TextBlock x:Name="CloudStatus" Foreground="#8A8A80" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Text="── 推送渠道" Style="{StaticResource H}"/>
                <CheckBox Content="Windows 通知（Toast）" IsChecked="{Binding UseToast}"/>

                <CheckBox Content="Telegram 推送" IsChecked="{Binding TelegramEnabled}"/>
                <TextBlock Text="Bot Token：" ToolTip="@BotFather 发 /newbot 建一个，把 Token 填进来"/>
                <TextBox Text="{Binding TelegramBotToken}" ToolTip="@BotFather 发 /newbot 建一个，把 Token 填进来"/>
                <TextBlock Text="Chat ID：" ToolTip="先给 Bot 发条消息，再点右边「获取」"/>
                <DockPanel>
                    <Button Content="获取" Style="{StaticResource Btn}" DockPanel.Dock="Right"
                            Click="FetchChatId_Click"
                            ToolTip="从 Bot 的消息记录里取（需先发过消息）"/>
                    <TextBox Text="{Binding TelegramChatId}" ToolTip="先给 Bot 发条消息，再点右边「获取」"/>
                </DockPanel>

                <CheckBox Content="Bark 推送（iOS）" IsChecked="{Binding BarkEnabled}"/>
                <TextBlock Text="设备 key：" ToolTip="装 Bark（iOS），把 App 里那串 key 粘进来&#x0a;自建服务器填带 key 的完整地址"/>
                <TextBox Text="{Binding BarkKey}" ToolTip="装 Bark（iOS），把 App 里那串 key 粘进来&#x0a;自建服务器填带 key 的完整地址"/>

                <CheckBox Content="WxPusher 推送（微信）" IsChecked="{Binding WxPusherEnabled}"/>
                <TextBlock Text="AppToken：" ToolTip="wxpusher.zjiecode.com 扫码登录 → 创建应用 → 复制 AT_ 开头的 appToken"/>
                <TextBox Text="{Binding WxPusherAppToken}" ToolTip="wxpusher.zjiecode.com 扫码登录 → 创建应用 → 复制 AT_ 开头的 appToken"/>
                <TextBlock Text="UID：" ToolTip="应用详情页扫码订阅后，用户管理里找 UID_ 开头那串"/>
                <TextBox Text="{Binding WxPusherUid}" ToolTip="应用详情页扫码订阅后，用户管理里找 UID_ 开头那串"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="发送测试推送" Style="{StaticResource Btn}" Click="TestPush_Click"/>
                    <TextBlock Text="{Binding PushTestResult}" VerticalAlignment="Center"
                               Foreground="#4C7A34" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 本地直报（仅自用版显示） -->
                <StackPanel x:Name="IngestSection">
                    <TextBlock Text="── 本地直报（可选增强）" Style="{StaticResource H}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#8A8A80"
                               Text="安装配套游戏插件后，逛房区/点门牌可将本服房屋数据直接推送到本工具（不经过网站）。将插件设置中的地址和令牌填为下方内容。"/>
                    <CheckBox Content="启用本地直报接收" IsChecked="{Binding LocalIngestEnabled}"/>
                    <TextBlock Text="{Binding IngestAddress, StringFormat='接收地址：{0}'}" TextWrapping="Wrap"/>
                    <TextBlock Text="令牌："/>
                    <DockPanel>
                        <Button Content="复制" Style="{StaticResource Btn}" DockPanel.Dock="Right"
                                Click="CopyToken_Click"/>
                        <TextBox Text="{Binding LocalIngestToken}" IsReadOnly="True"/>
                    </DockPanel>
                </StackPanel>

                <TextBlock Text="── 关于" Style="{StaticResource H}"/>
                <TextBlock TextWrapping="Wrap" Foreground="#8A8A80"
                           Text="数据来源：艾欧泽亚售楼中心 house.ffxiv.cyou（玩家上报数据，可能存在延迟）。本工具与 Square Enix、盛趣游戏无关。"/>

                <Button Content="保存并关闭" Style="{StaticResource Btn}" Background="#8B8B5E" Foreground="White"
                        HorizontalAlignment="Right" Margin="0,12,0,4" Click="Save_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
