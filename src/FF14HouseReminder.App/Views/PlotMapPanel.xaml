<UserControl x:Class="FF14HouseReminder.Views.PlotMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="382" Background="#D8D8CF"
             FontFamily="Tahoma, Microsoft YaHei UI" FontSize="12">
    <Border BorderBrush="#ABABA0" BorderThickness="1,0,0,0">
        <DockPanel Margin="10">

            <DockPanel DockPanel.Dock="Top">
                <TextBlock Text="⊙  房区图" FontWeight="Bold" Foreground="#55554A"
                           FontSize="14" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="✕ 关闭"
                        Background="#F2F2EB" Foreground="#3F3F38" BorderBrush="#ABABA0"
                        BorderThickness="1" Padding="10,4" Click="Close_Click"/>
            </DockPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,6">
                <ComboBox x:Name="AreaBox" Width="104" Margin="0,0,4,4" SelectionChanged="Selection_Changed"/>
                <ComboBox x:Name="SlotBox" Width="70" Margin="0,0,4,4" SelectionChanged="Selection_Changed"/>
                <ComboBox x:Name="HalfBox" Width="120" Margin="0,0,0,4" SelectionChanged="Selection_Changed"/>
            </WrapPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,7,0,0">
                <TextBlock x:Name="CountText" FontSize="11" Foreground="#55554A" FontWeight="Bold"/>
                <TextBlock FontSize="11" Foreground="#8A8A80" TextWrapping="Wrap" Margin="0,2,0,0">
                    <Run Text="■" Foreground="#A66A00"/><Run Text=" 可抽　"/>
                    <Run Text="□" Foreground="#c9a86a"/><Run Text=" 空置未开放　"/>
                    <Run Text="■" Foreground="#6b6b60"/><Run Text=" 已住人　"/>
                    <Run Text="滑过房屋列表高亮。上方为北，各小区布局相同。"/>
                </TextBlock>
            </StackPanel>

            <Border BorderBrush="#ABABA0" BorderThickness="1" Background="#F7F7F0">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="MapCanvas" ClipToBounds="True"/>
                </Viewbox>
            </Border>

        </DockPanel>
    </Border>
</UserControl>
