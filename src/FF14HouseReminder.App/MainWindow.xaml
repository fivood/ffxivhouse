<Window x:Class="FF14HouseReminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FF14HouseReminder.ViewModels"
        xmlns:local="clr-namespace:FF14HouseReminder"
        xmlns:views="clr-namespace:FF14HouseReminder.Views"
        Title="抽房了吗" Width="400" Height="780" MinWidth="360" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding AlwaysOnTop}"
        Background="#D8D8CF" Foreground="#3F3F38" FontSize="12"
        FontFamily="Tahoma, Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#D8D8CF"/>
        <SolidColorBrush x:Key="StripBg" Color="#EBEBE4"/>
        <SolidColorBrush x:Key="ContentBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderGray" Color="#ABABA0"/>
        <SolidColorBrush x:Key="TextDark" Color="#3F3F38"/>
        <SolidColorBrush x:Key="TextDim" Color="#8A8A80"/>
        <SolidColorBrush x:Key="Olive" Color="#8B8B5E"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <local:EmptyToVisConverter x:Key="EmptyToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 滚动条：4px 直角细条（和网页端一致）。WPF 改不了粗细，只能整个换模板；
             上下两个 RepeatButton 留着透明的，点轨道翻页照旧能用 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="#2d8c9d"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 尺寸多选的小方钮 -->
        <Style TargetType="ToggleButton" x:Key="SizeToggle">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#F2F2EB" BorderBrush="#ABABA0" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2d8c9d"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#14545e"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2d8c9d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 一行里混着按钮、下拉、日期框、输入框，高度统一才不会高低不齐
             （默认分别是 26 / 21.2 / 24 / 17.2） -->
        <Style TargetType="ComboBox"><Setter Property="Height" Value="26"/></Style>
        <Style TargetType="TextBox"><Setter Property="Height" Value="26"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Height" Value="26"/></Style>

        <!-- 复古方形按钮 -->
        <Style TargetType="Button" x:Key="RetroBtn">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#F2F2EB"/>
            <Setter Property="Foreground" Value="#3F3F38"/>
            <Setter Property="BorderBrush" Value="#ABABA0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#ABABA0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 面板标题条 -->
        <Style TargetType="Border" x:Key="Strip">
            <Setter Property="Background" Value="#EBEBE4"/>
            <Setter Property="BorderBrush" Value="#ABABA0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>

        <!-- 列表项：统一留白 -->
        <Style TargetType="ListBoxItem" x:Key="RoomyItem">
            <!-- 滑过任一房屋条目就在房区图上高亮它 -->
            <EventSetter Event="MouseEnter" Handler="Item_MouseEnter"/>
            <Setter Property="Padding" Value="6,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="#E3E3DA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- 内容白板 -->
        <Style TargetType="ListBox" x:Key="WhiteList">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ABABA0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 区域拖拽分隔条 -->
        <Style TargetType="GridSplitter">
            <Setter Property="Height" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#EBEBE4"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#ABABA0" BorderThickness="0,1">
                            <TextBlock Text="═" Foreground="#ABABA0" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="8"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ══ 主内容 ══ -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>            <!-- 标题栏 -->
                <RowDefinition Height="Auto"/>            <!-- 关注区标题 -->
                <RowDefinition Height="2*" MinHeight="120"/> <!-- 关注列表（可拖） -->
                <RowDefinition Height="Auto"/>            <!-- 我的房产 标题 -->
                <RowDefinition Height="Auto"/>            <!-- 我的房产 内容（可折叠） -->
                <RowDefinition Height="Auto"/>            <!-- 拖拽分隔条 -->
                <RowDefinition Height="3*" MinHeight="240"/> <!-- 浏览区（筛选+在售列表） -->
                <RowDefinition Height="Auto"/>            <!-- 状态栏 -->
            </Grid.RowDefinitions>

            <!-- 顶部按钮栏（标题在窗口标题栏里已经有了，这儿不再重复，省出宽度给按钮） -->
            <DockPanel Grid.Row="0" Margin="0,0,0,9">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="{Binding UpdateText}" Style="{StaticResource RetroBtn}"
                            Background="#F6E8C8" BorderBrush="#B06030" FontWeight="Bold"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                            Command="{Binding OpenUpdateCommand}"/>
                    <Button Content="↻ 刷新" Style="{StaticResource RetroBtn}" Command="{Binding RefreshCommand}"/>
                    <Button Content="🌐 售楼中心" Style="{StaticResource RetroBtn}" ToolTip="打开艾欧泽亚售楼中心网站"
                            Command="{Binding OpenWebsiteCommand}"/>
                    <Button Content="📌 置顶" ToolTip="窗口始终显示在最前" Command="{Binding ToggleTopCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RetroBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AlwaysOnTop}" Value="True">
                                        <Setter Property="Background" Value="#8B8B5E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⚙ 设置" Command="{Binding ToggleSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RetroBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSettings}" Value="True">
                                        <Setter Property="Background" Value="#8B8B5E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- 关注区 -->
            <Border Grid.Row="1" Style="{StaticResource Strip}">
                <TextBlock Text="⊙  我的关注" FontWeight="Bold" Foreground="#55554A"/>
            </Border>
            <ListBox Grid.Row="2" ItemsSource="{Binding WatchList}" Style="{StaticResource WhiteList}"
                     BorderThickness="1,0,1,1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:WatchViewModel">
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold" FontSize="13">
                                    <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                    <Run Text="{Binding SizeName, Mode=OneWay}" Foreground="#8B8B5E"/>
                                    <Run Text="{Binding ModeText, Mode=OneWay}" Foreground="#4C7A34"/>
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0">
                                    <Run Text="{Binding StateText, Mode=OneWay}"
                                         Foreground="{Binding StateColor}" FontWeight="Bold"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding CountdownText, Mode=OneWay}"
                                         Foreground="{Binding CountdownColor}"/>
                                    <Run Text="{Binding ParticipateText, Mode=OneWay}"
                                         Foreground="#8B5E3C" FontWeight="Bold"
                                         ToolTip="门牌上的已抽选人数，只有卫月插件点过门牌才有"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,5,0,0">
                                    <Run Text="{Binding SourceText, Mode=OneWay}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding FreshnessText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Button Content="{Binding ToggleModeText}" Style="{StaticResource RetroBtn}"
                                        Margin="0,0,0,3"
                                        Visibility="{Binding ShowModeButton, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.ToggleWatchModeCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3"
                                            Visibility="{Binding Asking, Converter={StaticResource BoolToVis}}">
                                    <Grid Width="96">
                                        <TextBox MaxLength="16"
                                                 Text="{Binding EntryNoInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="申请号码" Foreground="#ABABA0" FontSize="11"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0,0,0"
                                                   Visibility="{Binding EntryNoInput, Converter={StaticResource EmptyToVis}}"/>
                                    </Grid>
                                    <Button Content="✔" Style="{StaticResource RetroBtn}" Margin="3,0,0,0" ToolTip="确认"
                                            Command="{Binding DataContext.ConfirmEnteredCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="✕" Style="{StaticResource RetroBtn}" Margin="3,0,0,0" ToolTip="取消"
                                            Command="{Binding DataContext.CancelEnteredCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                                <Button Content="🗑" Style="{StaticResource RetroBtn}" ToolTip="移除关注"
                                        Command="{Binding DataContext.RemoveWatchCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <StaticResource ResourceKey="RoomyItem"/>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Grid.Row="2" Text="还没有关注&#10;在下面「在售房屋」里点 ＋关注" TextAlignment="Center"
                       Foreground="{StaticResource TextDim}" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding WatchEmpty, Converter={StaticResource BoolToVis}}"/>

            <!-- 我的房产（炸房提醒，可折叠） -->
            <Border Grid.Row="3" Style="{StaticResource Strip}" Cursor="Hand"
                    MouseLeftButtonUp="HomesStrip_Click" ToolTip="点击展开/收起">
                <DockPanel>
                    <TextBlock FontWeight="Bold" Foreground="#3a4a52" DockPanel.Dock="Left">
                        <Run Text="{Binding HomesArrow, Mode=OneWay}"/>
                        <Run Text=" 我的房产"/>
                        <Run Text="  45 天未进屋会拆除" FontWeight="Normal" Foreground="#4A5D66" FontSize="11"/>
                    </TextBlock>
                    <Button Content="+" Style="{StaticResource RetroBtn}" FontWeight="Bold"
                            Width="40" Height="18" Padding="0" FontSize="13" Margin="3,0,0,0"
                            DockPanel.Dock="Right" VerticalAlignment="Center"
                            ToolTip="登记我的房产"
                            Command="{Binding ToggleHomeFormCommand}"/>
                </DockPanel>
            </Border>
            <Border Grid.Row="4" Background="White" BorderBrush="#ABABA0" BorderThickness="1,0,1,1"
                    Visibility="{Binding ShowHomes, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Homes}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:HomeViewModel">
                                <StackPanel Margin="2,3">
                                    <TextBlock FontWeight="Bold" FontSize="13">
                                        <Run Text="{Binding PositionText, Mode=OneWay}"/>
                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="#8A8A80" FontSize="11"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,5,0,0" FontWeight="Bold" TextWrapping="Wrap"
                                               Text="{Binding StatusText, Mode=OneWay}"
                                               Foreground="{Binding StatusColor}"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="✔ 已进屋" Margin="0,0,4,0"
                                                Visibility="{Binding NotDemolished, Converter={StaticResource BoolToVis}}"
                                                ToolTip="打卡，重置倒计时"
                                                Command="{Binding DataContext.EnterHomeCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <!-- 打过卡就按 45 天倒计时上色（每 9 天一档），和旁边的灰按钮区分开 -->
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RetroBtn}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasEntered}" Value="True">
                                                            <Setter Property="Background" Value="{Binding EnterColor}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#55554A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <DatePicker SelectedDate="{Binding BackfillDate}" Width="105" Margin="0,0,4,0"
                                                    DisplayDateEnd="{Binding DataContext.Today, Mode=OneWay,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    ToolTip="补签或炸房日期，留空按今天"/>
                                        <Button Content="🗓" Style="{StaticResource RetroBtn}" Margin="0,0,4,0"
                                                Visibility="{Binding NotDemolished, Converter={StaticResource BoolToVis}}"
                                                ToolTip="按所选日期补签"
                                                Command="{Binding DataContext.BackfillHomeCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="📅" Style="{StaticResource RetroBtn}" Margin="0,0,4,0"
                                                Visibility="{Binding Demolished, Converter={StaticResource BoolToVis}}"
                                                ToolTip="改炸房日"
                                                Command="{Binding DataContext.SetDemolishDateCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{Binding DemolishText}" Style="{StaticResource RetroBtn}" Margin="0,0,4,0"
                                                ToolTip="{Binding DemolishTip}"
                                                Command="{Binding DataContext.DemolishHomeCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="🗑" Style="{StaticResource RetroBtn}" Margin="0" ToolTip="移除这套房产"
                                                Command="{Binding DataContext.RemoveHomeCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="RoomyItem"/>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <!-- 登记表单收进弹层，平时不占地方 -->
                    <Border x:Name="HomeFormPopup" Margin="8,4"
                            Visibility="{Binding ShowHomeForm, Converter={StaticResource BoolToVis}}"
                            Background="#F2F2EB" BorderBrush="#ABABA0" BorderThickness="1" Padding="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="#8A8A80"
                                       Text="登记我的房（登记即起算 45 天；角色名做备注）："/>
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ComboBox Grid.Row="0" Grid.Column="0" Margin="0,0,3,4"
                                          ItemsSource="{Binding Servers}"
                                          SelectedItem="{Binding HomeServer}" DisplayMemberPath="Name"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="3,0,0,4"
                                          SelectedIndex="{Binding HomeAreaIndex}">
                                    <ComboBoxItem Content="海雾村"/>
                                    <ComboBoxItem Content="薰衣草苗圃"/>
                                    <ComboBoxItem Content="高脚孤丘"/>
                                    <ComboBoxItem Content="白银乡"/>
                                    <ComboBoxItem Content="穹顶皓天"/>
                                </ComboBox>
                                <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,3,4"
                                         Text="{Binding HomeSlotText}" ToolTip="区号 1-30"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="3,0,0,4"
                                         Text="{Binding HomePlotText}" ToolTip="房号 1-60"/>
                                <TextBox Grid.Row="2" Grid.Column="0" Margin="0,0,3,0"
                                         Text="{Binding HomeLabelText}" ToolTip="角色名/备注"/>
                                <Button Grid.Row="2" Grid.Column="1" Margin="3,0,0,0" Content="🏠 登记"
                                        Style="{StaticResource RetroBtn}" Command="{Binding AddHomeCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding HomeHint}" Foreground="#B03030" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 拖拽分隔条 -->
            <GridSplitter Grid.Row="5" ResizeBehavior="PreviousAndNext"/>

            <!-- 浏览区 -->
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Strip}">
                    <DockPanel>
                        <TextBlock FontWeight="Bold" Foreground="#55554A"
                                   DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Run Text="⊙  在售房屋"/><Run Text="{Binding SalesCountText, Mode=OneWay}"
                                 FontWeight="Normal" FontSize="11" Foreground="#4A5D66"/>
                        </TextBlock>
                        <ComboBox Width="118" Margin="1" HorizontalAlignment="Right" DockPanel.Dock="Right"
                                  SelectedIndex="{Binding SortIndex}" ToolTip="排序方式">
                            <ComboBoxItem Content="默认(房区/房号)"/>
                            <ComboBoxItem Content="价格从低到高"/>
                            <ComboBoxItem Content="价格从高到低"/>
                            <ComboBoxItem Content="截止时间最近"/>
                            <ComboBoxItem Content="尺寸 L→S"/>
                            <ComboBoxItem Content="参与人数最少"/>
                            <ComboBoxItem Content="数据最新"/>
                        </ComboBox>
                    </DockPanel>
                </Border>
                <WrapPanel Grid.Row="1" Background="#EBEBE4">
                    <ComboBox Width="104" Margin="1" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                              DisplayMemberPath="Name"/>
                    <ComboBox Width="98" Margin="1" SelectedIndex="{Binding AreaFilterIndex}">
                        <ComboBoxItem Content="全部房区"/>
                        <ComboBoxItem Content="海雾村"/>
                        <ComboBoxItem Content="薰衣草苗圃"/>
                        <ComboBoxItem Content="高脚孤丘"/>
                        <ComboBoxItem Content="白银乡"/>
                        <ComboBoxItem Content="穹顶皓天"/>
                    </ComboBox>
                    <!-- 尺寸可多选：三个都不选＝不限 -->
                    <StackPanel Orientation="Horizontal" Margin="1">
                        <ToggleButton Content="S" IsChecked="{Binding SizeS}" Style="{StaticResource SizeToggle}"/>
                        <ToggleButton Content="M" IsChecked="{Binding SizeM}" Style="{StaticResource SizeToggle}"/>
                        <ToggleButton Content="L" IsChecked="{Binding SizeL}" Style="{StaticResource SizeToggle}"/>
                    </StackPanel>
                    <ComboBox Width="62" Margin="1" SelectedIndex="{Binding RegionFilterIndex}">
                        <ComboBoxItem Content="全部"/>
                        <ComboBoxItem Content="部队"/>
                        <ComboBoxItem Content="个人"/>
                    </ComboBox>
                    <Button Content="🗺 房区图" ToolTip="房区图：滑过房屋条目高亮对应地块"
                            Command="{Binding ToggleMapCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RetroBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowMap}" Value="True">
                                        <Setter Property="Background" Value="#8B8B5E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>

                <ListBox Grid.Row="2" ItemsSource="{Binding SalesList}" Style="{StaticResource WhiteList}"
                         BorderThickness="1,0,1,1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:HouseItemViewModel">
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="Bold" FontSize="13">
                                        <Run Text="{Binding PositionText, Mode=OneWay}"/>
                                        <Run Text="{Binding Badges, Mode=OneWay}" Foreground="{StaticResource TextDim}"
                                             FontSize="11"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,6,0,0">
                                        <Run Text="{Binding PriceText, Mode=OneWay}" Foreground="#A66A00"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,5,0,0">
                                        <Run Text="{Binding StateText, Mode=OneWay}"
                                             Foreground="{Binding StateColor}" FontWeight="Bold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding CountdownText, Mode=OneWay}"
                                             Foreground="{Binding CountdownColor}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"
                                        Content="{Binding WatchButtonText}" Style="{StaticResource RetroBtn}"
                                        IsEnabled="{Binding IsWatched, Converter={StaticResource InverseBool}}"
                                        Command="{Binding DataContext.AddWatchCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <StaticResource ResourceKey="RoomyItem"/>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding SalesEmptyText}" TextAlignment="Center"
                           Foreground="{StaticResource TextDim}" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SalesEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="7" Margin="0,6,0,0" Background="#EBEBE4" BorderBrush="#ABABA0"
                    BorderThickness="1" Padding="8,5">
                <WrapPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" Text="{Binding StatusText}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextDim}"
                               Visibility="{Binding ShowIngestStatus, Converter={StaticResource BoolToVis}}">
                        <Run Text="　│　直报: "/><Run Text="{Binding IngestStatusText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextDim}"
                               Text="　│　数据来源: house.ffxiv.cyou"
                               ToolTip="艾欧泽亚售楼中心（玩家上报数据）"/>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- ══ 右侧展开面板：设置 / 房区图，同时只开一个 ══ -->
        <views:SettingsPanel x:Name="SettingsPanelControl" Grid.Column="1" Visibility="Collapsed"/>
        <views:PlotMapPanel x:Name="PlotMapPanelControl" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
</Window>
